# Proveedor de IA: opencode | openai | anthropic | google | custom (Por defecto: opencode)
AI_PROVIDER=opencode

# API Key unificada (Soporta también OPENCODE_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY)
AI_MANAGER_KEY=sk-tu-api-key

# Modelo a utilizar según el proveedor
# Ejemplo OpenCode/OpenAI: deepseek-v4-pro, gpt-4o, claude-3-7-sonnet
# Ejemplo Anthropic: claude-3-7-sonnet-20250219
# Ejemplo Google: gemini-1.5-pro
AI_MODEL=minimax-m3

# Endpoint base personalizado (Opcional en opencode/openai/anthropic; Obligatorio en custom para Ollama/vLLM)
# Ejemplos: https://opencode.ai/zen/go/v1 | http://localhost:11434/v1
AI_BASE_URL=

# Temperatura de generación (Por defecto: 0.1)
AI_TEMPERATURE=0.1