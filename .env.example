# ============================================================
# CONFIGURACIÓN OBLIGATORIA - LeadGuard no funciona sin estas 3
# ============================================================

# Proveedor de IA (OBLIGATORIO): opencode | openai | anthropic | google | custom
AI_PROVIDER=

# API Key (OBLIGATORIO): key unificada o específica del proveedor
AI_MANAGER_KEY=

# Modelo (OBLIGATORIO): según el proveedor elegido
# Ejemplos: deepseek-v4-pro, gpt-4o, claude-3-7-sonnet, gemini-1.5-pro
AI_MODEL=

# ============================================================
# CONFIGURACIÓN OPCIONAL
# ============================================================

# Endpoint base (Obligatorio solo si AI_PROVIDER=custom)
# Ejemplos: https://opencode.ai/zen/go/v1 | http://localhost:11434/v1
AI_BASE_URL=

# Temperatura de generación (Default: 0.1)
AI_TEMPERATURE=0.1

# Máximo de tokens de salida (Default: 32000)
# Nota: asegúrate de que tu modelo/provider soporte este límite
# OpenAI gpt-4o: 16000 max | Anthropic Claude 3.7: 64000 | Gemini 1.5 Pro: 8192
AI_MAX_TOKENS=32000

# Nivel de log: debug | info | warn | error (Default: info)
LOG_LEVEL=info
